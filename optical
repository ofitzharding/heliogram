#!/usr/bin/env python3
"""
optical — send and receive files over a screen-to-camera link.

    ./optical send FILE               display FILE as a code, fullscreen
    ./optical recv CAPTURE OUT        recover FILE from a phone capture
    ./optical recv CAPTURE            recover, auto-naming the output
    ./optical bench CAPTURE           report goodput without writing a file

The send side picks the profile measured to work on consumer hardware; the
receive side auto-detects grid, mode, header version and lens distortion from
the capture itself, so a receiver needs no configuration and no camera
profile.

Recording, on any phone:
    normal video mode, 4K 60fps, landscape, 1x lens
    tap and hold on the code for AE/AF lock
    fill the frame but keep all four corner markers visible
"""
import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
POC = HERE / "poc"
sys.path.insert(0, str(POC))

# Profiles, ordered by throughput. Constants are MEASURED on real captures:
#   camera blur sigma ~3.6 px  ->  cells below ~13 camera-px collapse
#   eye opening 7.7 sigma at 13.1 px/cell  ->  2 levels only at that density
#   eye opening ~21 sigma at 17 px/cell    ->  4 levels safe there
PROFILES = {
    "fast": dict(grid="203x112", mode="gray4", cell_px=14, ecc=48,
                 raw_kbs=252.7, subblock=True,
                 note="4 grey levels + per-codeword fountain symbols; "
                      "174.3 KB/s bit-exact in validation = 1.36x decimen"),
    "safe": dict(grid="252x140", mode="mono", cell_px=12, ecc=48,
                 raw_kbs=197.8, subblock=True,
                 note="binary at 13.1 camera-px/cell; the profile proven bit-exact"),
    "record": dict(grid="252x140", mode="mono", cell_px=12, ecc=48,
                   raw_kbs=194.9, subblock=True,
                   note="252 cells rendered 3024 wide so the 2:1 playback copy "
                        "is exactly 1512 = the full window width. Measured "
                        "14.4 camera-px/cell, ABOVE the 13.5 that decoded at "
                        "0.4% BER. 194.9 KB/s of data with the grid full; "
                        "needs 66% yield."),
    "stretch": dict(grid="266x148", mode="mono", cell_px=11, ecc=48,
                    raw_kbs=219.2, subblock=True,
                    note="13.2 camera-px/cell, right at the measured wall. "
                         "219.2 KB/s, needs 59% yield. Film this second."),
    "robust": dict(grid="180x100", mode="mono", cell_px=16, ecc=64,
                   raw_kbs=110.0, subblock=False,
                   note="large cells, heavy ECC; for poor light or shaky hands"),
}


def run(cmd, **kw):
    return subprocess.run(cmd, shell=True, **kw)




def _chrome_hidden():
    """Hide the Dock and menu bar for the duration of a take.

    Not cosmetic. The window-mode playback (needed for true 60fps) leaves
    both visible, and Dock icons are rounded nested squares — i.e. textbook
    QR finder candidates, larger in area than the real corner markers. The
    first take at this geometry detected two Dock icons as finders, produced
    a degenerate homography, and decoded nothing.
    """
    import contextlib

    @contextlib.contextmanager
    def ctx():
        def setdock(auto_dock, auto_menu):
            try:
                subprocess.run(
                    ["/usr/bin/osascript", "-e",
                     'tell application "System Events" to tell dock preferences '
                     f'to set autohide to {auto_dock}',
                     "-e",
                     'tell application "System Events" to tell dock preferences '
                     f'to set autohide menu bar to {auto_menu}'],
                    capture_output=True, timeout=15)
            except Exception:
                pass
        setdock("true", "true")
        time.sleep(0.8)         # let the hide animation finish
        try:
            yield
        finally:
            setdock("false", "false")
    return ctx()


def _screen_decodes(profile):
    """Screenshot the panel mid-playback and try to decode the screenshot.

    The check that four wasted takes needed. A display path that cannot
    decode its OWN screen output will never be recoverable by a camera, and
    the failure is invisible to the eye: the window-mode render looked
    perfectly fine on screen while sitting at 47% structure agreement.
    """
    import tempfile
    import cv2
    from codec import grid
    p = PROFILES[profile]
    gw, gh = (int(v) for v in p["grid"].split("x"))
    shot = Path(tempfile.gettempdir()) / "_optical_selfcheck.png"
    if subprocess.run(["screencapture", "-x", "-t", "png", str(shot)],
                      capture_output=True).returncode:
        return None, "screencapture unavailable"
    img = cv2.imread(str(shot))
    shot.unlink(missing_ok=True)
    if img is None:
        return None, "screenshot unreadable"
    grid.set_ecc(p["ecc"]); grid.set_header_len(28)
    grid.set_header_centered(True); grid.set_radial(0.0)
    layout = grid.Layout(gw, gh)
    H = grid.locate(img, layout)
    if H is None:
        return False, "code not locatable in the screen output"
    cells, exp = grid.known_cells(layout)
    import numpy as np
    sm = grid.sample_cells(img, layout, H, cells).mean(axis=1)
    agree = 100 * ((sm > np.percentile(sm, 50)).astype(np.uint8) == exp).mean()
    hd, _s, _t = grid.sample_frame(img, layout, H)
    return (hd is not None and agree > 80), \
           f"structure {agree:.1f}%, header {'OK' if hd else 'FAIL'}"


def _panel_pixels():
    """Physical framebuffer size, which is what a fullscreen app draws into."""
    try:
        r = subprocess.run(["system_profiler", "SPDisplaysDataType"],
                           capture_output=True, timeout=20, text=True)
        import re
        m = re.search(r"Resolution:\s*(\d+)\s*x\s*(\d+)", r.stdout)
        if m:
            return int(m.group(1)), int(m.group(2))
    except Exception:
        pass
    return 3024, 1964


def _screen_points():
    """Logical (point) size of the main display. ffplay windows are sized in
    points; a window this size covers the screen while keeping the drawable
    small enough to present at a true 60 fps."""
    try:
        r = subprocess.run(
            ["/usr/bin/osascript", "-e",
             'tell application "Finder" to get bounds of window of desktop'],
            capture_output=True, timeout=10, text=True)
        parts = [int(v) for v in r.stdout.strip().split(", ")]
        if len(parts) == 4 and parts[2] > 100:
            return parts[2], parts[3]
    except Exception:
        pass
    return 1512, 982


def _video_frames(path):
    """Frame count, used by preflight to prove a clip is complete."""
    import cv2
    cap = cv2.VideoCapture(str(path))
    n = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    cap.release()
    return n


def _video_size(path):
    import cv2
    cap = cv2.VideoCapture(str(path))
    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)) or 2842
    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)) or 1568
    cap.release()
    return w, h


def _dialog(msg, buttons, default):
    """macOS dialog; returns True if the default (non-Cancel) button was hit.
    Falls back to Return-in-terminal when osascript is unavailable."""
    try:
        r = subprocess.run(
            ["/usr/bin/osascript", "-e",
             f'display dialog "{msg}" buttons {{{buttons}}} '
             f'default button "{default}" with title "optical"'],
            capture_output=True, timeout=3600)
        return r.returncode == 0
    except (FileNotFoundError, subprocess.TimeoutExpired):
        print(msg)
        try:
            input("(Return to continue) ")
            return True
        except (EOFError, KeyboardInterrupt):
            return False


def _make_countdown(dst, like, seconds=8, size=None):
    """Countdown clip whose BACKGROUND IS REAL CODE CONTENT.

    The first version showed white digits on black. That is a trap: the user
    locks AE/AF during the countdown, so the camera meters a ~5-luma scene,
    opens up, and then the code (50% duty cycle mono, ~127 luma) arrives
    massively overexposed — whites clip and the level spacing at the bright
    end compresses. The failed gray4 capture shows exactly that signature:
    levels at 106/158/211/241, i.e. spacings 52, 52, then 30.

    So the countdown must be photometrically identical to the payload. It
    uses a real rendered frame as background and writes the digits into the
    letterbox margin, where there are no data cells to occlude.
    """
    import cv2
    import numpy as np
    W, H = size if size else _video_size(like)
    bg = None
    cap = cv2.VideoCapture(str(like))
    cap.set(cv2.CAP_PROP_POS_FRAMES, 3)
    ok, frame = cap.read()
    cap.release()
    if ok and frame is not None:
        bg = cv2.resize(frame, (W, H), interpolation=cv2.INTER_NEAREST)
    if bg is None:
        bg = np.full((H, W, 3), 127, np.uint8)      # at least match the mean

    # find the letterbox margin: rows that are entirely dark in the render
    g = cv2.cvtColor(bg, cv2.COLOR_BGR2GRAY)
    rowmax = g.max(axis=1)
    dark = np.where(rowmax < 40)[0]
    band = None
    if len(dark):
        lo = dark[dark > H // 2]
        if len(lo) > 40:
            band = (int(lo[0]), int(lo[-1]))
    if band is None:
        band = (H - 90, H - 10)
    cy = (band[0] + band[1]) // 2
    bh = band[1] - band[0]

    try:
        vw = cv2.VideoWriter(str(dst), cv2.VideoWriter_fourcc(*"mp4v"), 60,
                             (W, H))
        for sec in range(seconds, 0, -1):
            f = bg.copy()
            txt = f"HIT RECORD + LOCK AE/AF   {sec}"
            scale = max(0.8, min(2.2, bh / 55.0))
            (tw, th), _ = cv2.getTextSize(txt, cv2.FONT_HERSHEY_SIMPLEX,
                                          scale, 3)
            cv2.putText(f, txt, (max(4, (W - tw) // 2), cy + th // 2),
                        cv2.FONT_HERSHEY_SIMPLEX, scale, (255, 255, 255), 3)
            for _ in range(60):
                vw.write(f)
        vw.release()
    except Exception:
        if dst.exists():
            dst.unlink()


def cmd_send(args):
    p = PROFILES[args.profile]
    src = Path(args.file).expanduser().resolve()
    if not src.exists():
        sys.exit(f"no such file: {src}")
    out = HERE / "demo" / f"_tx_{src.stem}_{args.profile}.mp4"
    out.parent.mkdir(exist_ok=True)

    size = src.stat().st_size
    print(f"file      {src.name}  ({size:,} bytes)")
    print(f"profile   {args.profile}: {p['note']}")
    print(f"raw rate  {p['raw_kbs']} KB/s at 60 fps\n")

    if out.exists() and not args.force:
        print(f"reusing {out.name} (pass --force to re-encode)")
    else:
        rc = run(f"cd {POC} && python3 encode.py {src!s} {out!s} "
                 f"--mode {p['mode']} --grid {p['grid']} --cell-px {p['cell_px']} "
                 f"--fps 60 --overhead {args.overhead} --ecc {p['ecc']} "
                 f"{'--subblock' if p.get('subblock') else ''}")
        if rc.returncode:
            sys.exit("encode failed")

    meta = out.with_suffix(".json")
    meta.write_text(json.dumps(dict(file=src.name, size=size,
                                    profile=args.profile, **p), indent=2))

    print("\nOn the phone: 4K 60fps, landscape, 1x, AE/AF locked (tap and")
    print("hold on the code), all four corner markers in frame, brightness MAX.")
    if not args.auto:
        if not _dialog("Ready to film.\n\n"
                       "1. Press Start.\n"
                       "2. Hit RECORD on the phone during the countdown.\n"
                       "3. Playback stops by itself after "
                       f"{args.loops} loops (~{args.loops * 13}s).",
                       '"Cancel", "Start"', "Start"):
            return
    # DISPLAY PATH, measured by screenshotting the panel and decoding the
    # screenshot. That is the only test that matters, and it is the one that
    # was missing while four takes were filmed against a broken path:
    #
    #   1512-point window   981/1000 mid-band px, 47% structure, header FAIL
    #   fullscreen native    19/1000 mid-band px, 96% structure, header OK
    #
    # The window is not DPI-aware, so macOS renders the code at 1512px and
    # smoothly upscales it to the 3024px panel, destroying the cells before
    # any camera sees them. Fullscreen at the panel's native size maps 1:1.
    #
    # Fullscreen was abandoned earlier for running at 26.7fps. Re-measured on
    # an idle machine it does 55.4fps: the original figure was taken while
    # background encodes were saturating the CPU, and that one bad number is
    # what sent playback into window mode in the first place.
    pw, ph = _panel_pixels()
    vw, vh = _video_size(out)
    play = out.with_name(out.stem + f"_fs{pw}x{ph}.mp4")
    if not play.exists() or play.stat().st_mtime < out.stat().st_mtime:
        print(f"preparing native {pw}x{ph} playback copy (one-time)…")
        vf = ""
        if vw > pw or vh > ph:
            n = int(max(1, -(-max(vw / pw, vh / ph) // 1)))
            vf = f"scale={vw // n}:{vh // n}:flags=neighbor,"
        rc = run(f'ffmpeg -v error -y -i "{out}" '
                 f'-vf "{vf}pad={pw}:{ph}:(ow-iw)/2:(oh-ih)/2:black" '
                 f'-c:v libx264 -crf 8 -preset fast -tune stillimage '
                 f'-pix_fmt yuv420p "{play}"')
        if rc.returncode:
            play = out

    # PREFLIGHT. The failure this prevents: a take was filmed 43 seconds
    # before its own encode finished, against a stale playback copy, and
    # nothing in the tool said so. Verify every input is complete and newer
    # than its source, and refuse to roll if not.
    if not play.exists() or play.stat().st_size < 1_000_000:
        sys.exit(f"playback copy missing or truncated: {play}")
    pf = _video_frames(play)
    if pf < 10:
        sys.exit(f"playback copy unreadable ({pf} frames)")
    print(f"playback  {play.name}  {pf} frames, fullscreen {pw}x{ph}")

    cd_clip = out.parent / f"_countdown_{args.profile}_{args.countdown}.mp4"
    if not cd_clip.exists():
        _make_countdown(cd_clip, play, args.countdown, (pw, ph))
    if not cd_clip.exists() or _video_frames(cd_clip) < args.countdown * 30:
        sys.exit("countdown clip failed to build - refusing to roll without "
                 "the AE/AF lock target (it silently skipped once and cost a "
                 "take)")
    with _chrome_hidden():
        if True:
            print(f"\ncountdown starts NOW — hit record on the phone when you "
                  f"see it on screen ({args.countdown}s).")
            import threading
            chk = {}
            def _probe():
                time.sleep(2.5)
                chk["r"] = _screen_decodes(args.profile)
            t = threading.Thread(target=_probe, daemon=True); t.start()
            run(f'ffplay -fs -alwaysontop -noborder -autoexit "{cd_clip}"')
            t.join(timeout=5)
            ok, why = chk.get("r", (None, "not run"))
            if ok is False:
                sys.exit(f"SCREEN SELF-CHECK FAILED ({why}). The display path "
                         f"is destroying the code before any camera sees it; "
                         f"filming would be wasted.")
            print(f"screen self-check: {why}")
        print("playing… stops by itself, keep filming until the screen goes "
              "back to normal")
        t0 = time.time()
        run(f'ffplay -fs -alwaysontop -noborder -loop {args.loops} '
            f'-autoexit "{play}"')
        shown = time.time() - t0
    meta.write_text(json.dumps(dict(file=src.name, size=size,
                                    profile=args.profile, shown_seconds=round(shown, 2),
                                    loops=args.loops, **p), indent=2))
    print(f"\ndisplayed for {shown:.1f}s  "
          f"(raw budget at {p['raw_kbs']} KB/s: {p['raw_kbs'] * shown:,.0f} KB shown)")
    print("\n3. Stop recording. AirDrop the capture to this Mac")
    print(f"   (it lands in ~/Downloads), then:")
    print(f"\n   ./optical recv ~/Downloads/<capture>.mov")
    if not args.auto:
        _dialog(f"Done: the code was displayed for {shown:.1f}s.\n\n"
                "Stop recording, AirDrop the capture to this Mac, then run:\n\n"
                "./optical recv ~/Downloads/<capture>.mov", '"OK"', "OK")


def _detect(capture):
    """Recover transmission parameters from the capture itself."""
    import cv2
    import numpy as np
    from codec import grid

    cap = cv2.VideoCapture(str(capture))
    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) or 600
    frames = []
    for fi in np.linspace(total * 0.2, total * 0.85, 8).astype(int):
        cap.set(cv2.CAP_PROP_POS_FRAMES, int(fi))
        ok, im = cap.read()
        if ok:
            frames.append(im)
    cap.release()
    if not frames:
        sys.exit("could not read the capture")

    best = None
    for name, p in PROFILES.items():
        gw, gh = (int(v) for v in p["grid"].split("x"))
        for hl, centered in ((28, True), (28, False), (24, False)):
            grid.set_ecc(p["ecc"])
            grid.set_header_len(hl)
            grid.set_header_centered(centered)
            grid.set_fast_sample(p["mode"] == "mono")
            layout = grid.Layout(gw, gh)
            for k1 in (0.020, 0.0):
                grid.set_radial(k1)
                hits = 0
                for im in frames:
                    H = grid.locate(im, layout)
                    if H is None:
                        continue
                    hd, _s, _st = grid.sample_frame(im, layout, H)
                    hits += hd is not None
                if best is None or hits > best[0]:
                    best = (hits, name, p, hl, k1, centered)
    hits, name, p, hl, k1, centered = best
    if hits == 0:
        sys.exit("no readable frames: check that the whole code, including all "
                 "four corner markers, is in frame and in focus")
    print(f"detected  profile={name} grid={p['grid']} mode={p['mode']} "
          f"header=v{'2' if hl == 28 else '1'}{'-centred' if centered else '-top'} "
          f"k1={k1:+.3f}  ({hits}/{len(frames)} probe frames)")
    return name, p, hl, k1, centered


def cmd_recv(args):
    capture = Path(args.capture).expanduser().resolve()
    if not capture.exists():
        sys.exit(f"no such capture: {capture}")
    name, p, hl, k1, centered = _detect(capture)
    out = Path(args.out) if args.out else Path.cwd() / f"recovered_{capture.stem}.bin"
    t0 = time.time()
    rc = run(f"cd {POC} && python3 fast_decode.py {capture!s} {out!s} "
             f"--grid {p['grid']} --ecc {p['ecc']} --radial {k1} --header-len {hl} "
             f"{'--header-top' if not centered else ''} "
             f"{'--subblock' if p.get('subblock') else ''} --scan")
    if rc.returncode:
        sys.exit("\nrecovery failed. Try: better light, hold steadier, or "
                 "re-send with --profile robust")
    print(f"\nwrote {out}  ({time.time()-t0:.0f}s)")


def cmd_bench(args):
    capture = Path(args.capture).expanduser().resolve()
    name, p, hl, k1, centered = _detect(capture)
    tmp = Path("/tmp/_optical_bench.bin")
    run(f"cd {POC} && python3 fast_decode.py {capture!s} {tmp!s} "
        f"--grid {p['grid']} --ecc {p['ecc']} --radial {k1} --header-len {hl} "
        f"{'--header-top' if not centered else ''} "
        f"{'--subblock' if p.get('subblock') else ''} --scan")


def main():
    ap = argparse.ArgumentParser(prog="optical",
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("send", help="display a file as an optical code")
    s.add_argument("file")
    s.add_argument("--profile", default="fast", choices=list(PROFILES))
    s.add_argument("--overhead", type=float, default=2.2)
    s.add_argument("--loops", type=int, default=3)
    s.add_argument("--auto", action="store_true",
                   help="no dialogs: countdown, play, stop. The countdown IS "
                        "the cue to hit record.")
    s.add_argument("--countdown", type=int, default=8,
                   help="seconds of on-screen countdown before the code")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_send)

    r = sub.add_parser("recv", help="recover a file from a phone capture")
    r.add_argument("capture")
    r.add_argument("out", nargs="?")
    r.set_defaults(fn=cmd_recv)

    b = sub.add_parser("bench", help="measure goodput from a capture")
    b.add_argument("capture")
    b.set_defaults(fn=cmd_bench)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
